# =============================================================================
# Remote Control Agent - Configuration
# =============================================================================
# Copy this file to .env and fill in your values.

# --- Anthropic API Key (REQUIRED) ---
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Proxy Settings (optional) ---
# If using the OAuth proxy, the agent connects to this URL instead of Anthropic.
# ANTHROPIC_BASE_URL=http://localhost:9090/proxy/anthropic

# Proxy server port (default: 9090)
# PROXY_PORT=9090

# Proxy server host (default: 0.0.0.0)
# PROXY_HOST=0.0.0.0

# Rate limit per token per minute (default: 60)
# RATE_LIMIT_PER_MINUTE=60

# Token expiry in seconds (default: 86400 = 24 hours, 0 = never)
# TOKEN_EXPIRY_SECONDS=86400

# --- Screen Resolution (optional) ---
# Override auto-detected resolution. Recommended: 1024x768 for best accuracy.
# WIDTH=1024
# HEIGHT=768
