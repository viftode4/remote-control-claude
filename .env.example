# =============================================================================
# Remote Control Agent - Configuration
# =============================================================================
# Copy this file to .env and fill in your values.

# --- OAuth Token ---
# Your OAuth token for the Anthropic API. Enter it in the agent UI sidebar.
# No API key needed — your OAuth token IS the authentication.

# --- Proxy Settings ---
# The agent connects to the proxy, which forwards your OAuth token to Anthropic.
# ANTHROPIC_BASE_URL=http://localhost:9090/proxy/anthropic

# Proxy server port (default: 9090)
# PROXY_PORT=9090

# Proxy server host (default: 0.0.0.0)
# PROXY_HOST=0.0.0.0

# Rate limit per user per minute (default: 60)
# RATE_LIMIT_PER_MINUTE=60

# --- Screen Resolution (optional) ---
# Override auto-detected resolution. Recommended: 1024x768 for best accuracy.
# WIDTH=1024
# HEIGHT=768
